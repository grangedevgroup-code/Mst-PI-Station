#!/usr/sbin/nft -f
# nftables configuration for Mst-PI-Station
# Generated by Mst-PI-Station — do not edit manually
# Policy: {{ policy }}

flush ruleset

define AP_IFACE   = {{ ap_interface }}
define MESH_IFACE = {{ mesh_interface }}
{% if uplink_interface %}
define WAN_IFACE  = {{ uplink_interface }}
{% endif %}
define AP_NET     = {{ hotspot_subnet }}
define AP_IP      = {{ hotspot_ip }}

table inet mstpistation {

    chain input {
        type filter hook input priority 0; policy drop;

        # Accept established/related
        ct state established,related accept

        # Accept loopback
        iifname "lo" accept

        # Accept ICMP (needed for network diagnostics)
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # Accept from AP/LAN clients
        iifname $AP_IFACE accept

        # Accept from mesh
        iifname $MESH_IFACE accept

        # Accept bat0 (batman-adv bridge interface)
        iifname "bat0" accept

        {% if policy == "open" %}
        # Open policy — accept all inbound
        accept
        {% else %}
        # Reject WAN-initiated connections to management services
        # Accept SSH (key auth enforced separately)
        tcp dport 22 accept

        # Accept Mst-PI-Station dashboard (LAN only — enforced by iifname above)
        tcp dport 8080 accept

        # Accept Reticulum
        tcp dport 4242 accept

        # Accept DNS/DHCP from LAN
        udp dport 53 accept
        tcp dport 53 accept
        udp dport 67 accept

        # Accept NTP
        udp dport 123 accept

        # Accept WireGuard (if enabled)
        udp dport {{ wireguard_port | default(51820) }} accept

        # Log and drop everything else from WAN
        {% if uplink_interface %}
        iifname $WAN_IFACE log prefix "MSTPISTATION-DROP: " drop
        {% endif %}
        {% endif %}
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept

        # LAN → WAN forwarding (if uplink available)
        {% if uplink_interface %}
        iifname $AP_IFACE oifname $WAN_IFACE accept
        iifname "bat0"    oifname $WAN_IFACE accept
        {% endif %}

        # Mesh ↔ LAN
        iifname $AP_IFACE   oifname $MESH_IFACE accept
        iifname $MESH_IFACE oifname $AP_IFACE   accept
        iifname "bat0"      oifname $AP_IFACE   accept
        iifname $AP_IFACE   oifname "bat0"      accept

        # Intra-LAN
        iifname $AP_IFACE oifname $AP_IFACE accept
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }

    {% if uplink_interface %}
    chain postrouting {
        type nat hook postrouting priority 100;
        # Masquerade outbound traffic to WAN
        oifname $WAN_IFACE masquerade
    }
    {% endif %}
}
