# Reticulum Network Configuration
# Generated by Aetherium — do not edit manually
# Edit: /etc/aetherium/aetherium.yaml → aetherium deploy {{ node_profile }}

[reticulum]
  enable_transport = {{ "Yes" if rns_transport else "No" }}
  share_instance = Yes
  shared_instance_port = 37428
  instance_control_port = 37429
  panic_on_interface_error = No

[logging]
  loglevel = 4

{% if autointerface_enabled %}
[interface:AutoInterface]
  type = AutoInterface
  interface_enabled = True
  group_id = {{ autointerface_group | default("aetherium") }}
{% endif %}

{% if tcp_server_enabled %}
[interface:TCPServerInterface]
  type = TCPServerInterface
  interface_enabled = True
  listen_ip = 0.0.0.0
  listen_port = {{ tcp_server_port | default(4242) }}
  prefer_ipv6 = No
{% endif %}

{% if rnode_enabled and rnode_port %}
[interface:RNodeInterface]
  type = RNodeInterface
  interface_enabled = True
  port = {{ rnode_port }}
  frequency = {{ rnode_frequency | default(915000000) }}
  bandwidth = {{ rnode_bandwidth | default(125000) }}
  txpower = {{ rnode_tx_power | default(17) }}
  spreading_factor = {{ rnode_sf | default(7) }}
  coding_rate = {{ rnode_coding_rate | default(5) }}
{% endif %}

{% for iface in extra_interfaces %}
[interface:{{ iface.name }}]
  type = {{ iface.type }}
  interface_enabled = {{ iface.enabled | default(True) }}
{% for k, v in iface.items() %}
{% if k not in ("name", "type", "enabled") %}
  {{ k }} = {{ v }}
{% endif %}
{% endfor %}
{% endfor %}
