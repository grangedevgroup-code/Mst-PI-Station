# WireGuard configuration for Aetherium
# Generated by Aetherium — do not edit manually

[Interface]
PrivateKey = {{ wg_private_key }}
Address = {{ wg_address }}/{{ wg_prefix | default(24) }}
ListenPort = {{ wg_port | default(51820) }}
DNS = {{ wg_dns | default("1.1.1.1") }}

# Save and restore routes on interface up/down
PreUp = sysctl -w net.ipv4.ip_forward=1
PostDown = ip route del {{ wg_subnet | default("10.10.0.0/24") }} dev %i 2>/dev/null || true

{% for peer in wg_peers %}
[Peer]
# {{ peer.name | default("peer") }}
PublicKey = {{ peer.public_key }}
{% if peer.preshared_key %}
PresharedKey = {{ peer.preshared_key }}
{% endif %}
AllowedIPs = {{ peer.allowed_ips | join(", ") }}
{% if peer.endpoint %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.keepalive %}
PersistentKeepalive = {{ peer.keepalive }}
{% endif %}

{% endfor %}
