[Unit]
Description=Mst-PI-Station Watchdog — secondary service self-healer
After=mstpistation-agent.service
# OPTIONAL redundancy. The primary mstpistation-agent already self-heals services,
# and systemd restarts the agent itself (Restart=always). Enable this only if
# you want a second, independent healer that does nothing but restart failed
# units:   sudo systemctl enable --now mstpistation-watchdog
# It is intentionally NOT enabled by the installer.

[Service]
Type=simple
# --watchdog-only runs the agent's healer loop alone (no status/failover/peers),
# so it never races the primary agent's status/failover work. It keeps its own
# loop + backoff state instead of being respawned from a bash sleep loop.
ExecStart=/opt/mstpistation/venv/bin/python3 /opt/mstpistation/core/agent.py --watchdog-only
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mstpistation-watchdog

[Install]
WantedBy=multi-user.target
