# hostapd configuration
# Generated by Aetherium — do not edit manually

interface={{ ap_interface }}
driver=nl80211
ssid={{ ssid }}
hw_mode={{ "g" if band == "2.4GHz" else "a" }}
channel={{ channel }}
wmm_enabled=1
macaddr_acl=0
auth_algs=1

{% if password %}
wpa=2
wpa_passphrase={{ password }}
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
{% else %}
# Open network — no password
{% endif %}

{% if hidden %}
ignore_broadcast_ssid=1
{% else %}
ignore_broadcast_ssid=0
{% endif %}

# IEEE 802.11n (Wi-Fi 4) settings
ieee80211n=1
ht_capab=[HT40][SHORT-GI-20][SHORT-GI-40][DSSS_CCK-40]

# Control interface for runtime management
ctrl_interface=/var/run/hostapd
ctrl_interface_group=0

# Country code — set your country for legal compliance
{% if country_code %}
country_code={{ country_code }}
ieee80211d=1
{% endif %}

# Maximum number of stations
{% if max_clients %}
max_num_sta={{ max_clients }}
{% endif %}

# Beacon interval
beacon_int=100

# DTIM period
dtim_period=2
