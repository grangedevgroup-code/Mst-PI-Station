#!/usr/bin/env bash
# batman-adv interface setup script
# Generated by Mst-PI-Station — do not edit manually

MESH_IFACE="{{ mesh_interface }}"
GW_MODE="{{ gw_mode | default("off") }}"
GW_BW="{{ gw_bandwidth | default("100mbit/100mbit") }}"

set -euo pipefail

# Load batman-adv kernel module
modprobe batman-adv || { echo "Failed to load batman-adv module"; exit 1; }

# Disable mesh interface from NetworkManager
if nmcli device show "${MESH_IFACE}" &>/dev/null 2>&1; then
    nmcli device set "${MESH_IFACE}" managed no 2>/dev/null || true
fi

# Bring interface down before reconfiguring
ip link set "${MESH_IFACE}" down 2>/dev/null || true
sleep 0.5

# Set interface to ad-hoc / IBSS mode for batman-adv
iw dev "${MESH_IFACE}" set type ibss 2>/dev/null || true

# Bring interface back up
ip link set "${MESH_IFACE}" up

# Join mesh IBSS cell
iw dev "${MESH_IFACE}" ibss join "MstPiStationMesh" {{ mesh_frequency | default(2412) }} \
    HT20 fixed-freq 02:12:34:56:78:9a 2>/dev/null || true

# Add interface to batman-adv
if ! batctl if | grep -q "${MESH_IFACE}"; then
    batctl if add "${MESH_IFACE}"
fi

# Bring up bat0
ip link set up dev bat0

# Set gateway mode
batctl gw_mode "${GW_MODE}"{% if gw_mode == "server" %} "${GW_BW}"{% endif %}


# Assign IP to bat0
{% if batman_ip %}
ip addr flush dev bat0
ip addr add "{{ batman_ip }}/8" dev bat0
{% endif %}

# Enable IP forwarding
sysctl -w net.ipv4.ip_forward=1 >/dev/null

echo "batman-adv: ${MESH_IFACE} → bat0 | gw_mode=${GW_MODE}"
