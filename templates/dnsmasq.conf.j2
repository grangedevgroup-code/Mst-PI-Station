# dnsmasq configuration for Aetherium
# Generated by Aetherium — do not edit manually

# Listen only on AP interface and loopback
interface={{ ap_interface }}
bind-interfaces
listen-address={{ hotspot_ip }},127.0.0.1

# DHCP range
dhcp-range={{ dhcp_start }},{{ dhcp_end }},{{ dhcp_netmask }},{{ dhcp_lease_time | default("2h") }}
dhcp-option=option:router,{{ hotspot_ip }}
dhcp-option=option:dns-server,{{ hotspot_ip }}

# Local domain
domain={{ local_domain | default("aetherium.local") }}
local=/{{ local_domain | default("aetherium.local") }}/
expand-hosts

# Local DNS entries
address=/{{ node_name }}.local/{{ hotspot_ip }}
address=/waystation.local/{{ hotspot_ip }}
address=/aetherium.local/{{ hotspot_ip }}
address=/dashboard.local/{{ hotspot_ip }}

{% if captive_portal %}
# Captive portal — redirect all DNS queries for unknown hosts to portal
address=/#/{{ hotspot_ip }}
{% else %}
# Forward unknown queries upstream
{% if uplink_available %}
server=8.8.8.8
server=1.1.1.1
{% endif %}
{% endif %}

# Security
bogus-priv
no-resolv
no-hosts

# Logging
log-queries=extra
log-facility=/var/log/aetherium/dnsmasq.log

# Performance
cache-size=1000
neg-ttl=60
